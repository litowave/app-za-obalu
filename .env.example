# Lokalni Supabase (vrijednosti ispisuje `pnpm db:start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Javni VAPID ključ za web push (npx web-push generate-vapid-keys); privatni ide u tajne funkcije send-push
EXPO_PUBLIC_VAPID_PUBLIC_KEY=

# Podloga karte (neobavezno). Zadano je OpenFreeMap, besplatno i bez ključa.
# NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/positron

# Prijava Googleom i Appleom za lokalni Supabase (docs/prijava-google-apple.md).
# Na pravom projektu ovi ključevi se upisuju u Supabase nadzornu ploču, ne ovdje.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# Gumb "Nastavi s Appleom" (skriven dok nema Apple Developer računa).
# EXPO_PUBLIC_APPLE_SIGNIN=1
