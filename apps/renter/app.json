{
  "expo": {
    "name": "Lito bilježnica",
    "slug": "obala-partner",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "hr.lito.obala.partner"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "hr.lito.obala.partner"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "obala-partner",
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#1F5A55"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
