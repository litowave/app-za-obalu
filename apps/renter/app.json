{
  "expo": {
    "name": "Lito bilježnica",
    "slug": "obala-partner",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "hr.lito.obala.partner",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "hr.lito.obala.partner"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro",
      "name": "Lito bilježnica",
      "shortName": "Lito",
      "lang": "hr",
      "themeColor": "#FFFFFF",
      "backgroundColor": "#FFFFFF"
    },
    "scheme": "obala-partner",
    "plugins": ["expo-router", "expo-font", "expo-web-browser", "expo-apple-authentication"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
